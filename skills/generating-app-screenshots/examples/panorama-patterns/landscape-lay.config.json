{
  "app": {
    "name": "Panorama pattern: landscape-lay"
  },
  "locales": [
    "en-US"
  ],
  "targets": [
    {
      "id": "iphone",
      "w": 1320,
      "h": 2868,
      "model": "iphone",
      "label": "iPhone 6.9\""
    }
  ],
  "output": "out/landscape-lay",
  "theme": {
    "preset": "mono",
    "font": {
      "family": "Plus Jakarta Sans",
      "weights": [
        500,
        600,
        700,
        800
      ]
    },
    "device": {
      "style": "real",
      "glare": true
    }
  },
  "panorama": {
    "pattern": "landscape-lay",
    "background": {
      "gradient": {
        "angle": 180,
        "stops": [
          "#09090b",
          "#18181b"
        ]
      },
      "scene": {
        "type": "stars",
        "count": 500,
        "starsTo": 1,
        "seed": 4
      }
    },
    "patternOptions": {
      "landscapeScreen": "../gallery/screens/focus.html"
    }
  },
  "slides": [
    {
      "id": "hook",
      "eyebrow": "Habit tracker",
      "title": "Build habits that **actually stick**",
      "screen": "../gallery/screens/home.html"
    },
    {
      "id": "progress",
      "title": "See your **progress** grow",
      "screen": "../gallery/screens/stats.html"
    },
    {
      "id": "remind",
      "title": "Gentle **reminders**",
      "screen": "../gallery/screens/remind.html"
    },
    {
      "id": "badges",
      "title": "Earn every **badge**",
      "screen": "../gallery/screens/profile.html"
    },
    {
      "id": "focus",
      "title": "Deep **focus** mode",
      "screen": "../gallery/screens/focus.html"
    }
  ]
}